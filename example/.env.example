# Copy this file to example/.env and fill in your values.
# This file is only used by the example app, not the library itself.
# Variables must start with EXPO_PUBLIC_ to be available in the Expo client.

# Local Odoo demo (Docker)
EXPO_PUBLIC_ODOO_HOST=http://localhost:8069
EXPO_PUBLIC_ODOO_DATABASE=demo
EXPO_PUBLIC_ODOO_API_KEY=your_api_key_here

# Alternative: Odoo online demo
# EXPO_PUBLIC_ODOO_HOST=https://demo.odoo.com
# EXPO_PUBLIC_ODOO_DATABASE=
# EXPO_PUBLIC_ODOO_API_KEY=
