{
  "name": "rn-odoo",
  "version": "2.0.0",
  "description": "Easy to connecting React Native and Odoo via JSON-2 API",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace example",
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "clean": "del-cli lib",
    "prepare": "bob build",
    "prepublishOnly": "bob build",
    "release": "release-it --only-version"
  },
  "keywords": [
    "odoo",
    "odoo-connector",
    "react-native",
    "react",
    "json-rpc",
    "mobile",
    "odoo api"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cqminh/rn-odoo.git"
  },
  "author": "Châu Quang Minh <cqminh.it@gmail.com> (https://github.com/cqminh)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cqminh/rn-odoo/issues"
  },
  "homepage": "https://github.com/cqminh/rn-odoo#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/compat": "^1.2.7",
    "@eslint/eslintrc": "^3.3.0",
    "@eslint/js": "^9.22.0",
    "@evilmartians/lefthook": "^1.5.0",
    "@react-native/babel-preset": "0.78.2",
    "@react-native/eslint-config": "^0.78.0",
    "@release-it/conventional-changelog": "^9.0.2",
    "@types/jest": "^29.5.5",
    "@types/react": "^19.0.12",
    "commitlint": "^19.6.1",
    "del-cli": "^5.1.0",
    "eslint": "^9.22.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-jest": "^29.15.2",
    "eslint-plugin-prettier": "^5.2.3",
    "jest": "^29.7.0",
    "prettier": "^3.0.3",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-builder-bob": "^0.40.8",
    "release-it": "^17.10.0",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*"
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@3.6.1",
  "resolutions": {
    "slash": "^3.0.0",
    "chalk": "^4.1.2",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "lodash": "^4.18.1",
    "tmp": "^0.2.3",
    "uuid": "^14.0.1",
    "shell-quote": "^1.10.0",
    "fast-uri": "^3.1.4",
    "brace-expansion@^1.1.7": "1.1.16",
    "brace-expansion@^2.0.2": "2.1.2",
    "brace-expansion@^5.0.5": "5.0.8",
    "js-yaml@^4.1.0": "4.3.0",
    "js-yaml@^4.1.1": "4.3.0",
    "postcss": "8.5.23",
    "@conventional-changelog/git-client@^1.0.0": "2.7.0"
  },
  "jest": {
    "preset": "react-native",
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/",
      "<rootDir>/src/__tests__/__mocks__/"
    ],
    "moduleNameMapper": {
      "^slash$": "<rootDir>/src/__tests__/__mocks__/slash.js"
    }
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false,
    "endOfLine": "auto"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "create-react-native-library": {
    "languages": "js",
    "type": "library",
    "version": "0.51.1"
  }
}
